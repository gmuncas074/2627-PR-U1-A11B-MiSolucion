<mxfile host="app.diagrams.net">
  <diagram name="Acceso con intentos limitados" id="acceso">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="inicio" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="claveCorrecta = 2468&lt;br&gt;intentos = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pide" value="Escribe &quot;Introduce la clave numérica&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="170" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lee" value="Lee clave" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cuenta" value="intentos = intentos + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="¿clave == claveCorrecta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="410" y="410" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="Escribe &quot;Acceso permitido.&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="435" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="¿intentos &amp;lt; 3?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="410" y="560" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resta" value="restantes = 3 - intentos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="585" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="incorrecta" value="Escribe &quot;Clave incorrecta. Intentos restantes: &quot; + restantes" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bloqueo" value="Escribe &quot;Acceso bloqueado.&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="710" width="220" height="50" as="geometry" />
